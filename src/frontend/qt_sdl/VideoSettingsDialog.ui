<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>VideoSettingsDialog</class>
 <widget class="QDialog" name="VideoSettingsDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>514</width>
    <height>316</height>
   </rect>
  </property>
  <property name="sizePolicy">
   <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
    <horstretch>0</horstretch>
    <verstretch>0</verstretch>
   </sizepolicy>
  </property>
  <property name="windowTitle">
   <string>Video settings - melonDS</string>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <property name="sizeConstraint">
    <enum>QLayout::SizeConstraint::SetFixedSize</enum>
   </property>
   <item row="0" column="0" alignment="Qt::AlignmentFlag::AlignTop">
    <widget class="QGroupBox" name="grpRenderer">
     <property name="title">
      <string>Renderer</string>
     </property>
     <layout class="QVBoxLayout" name="layoutRenderer">
      <item>
       <widget class="QRadioButton" name="rb3DSoftware">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The software renderer is more accurate and less prone to rendering glitches, but requires more CPU power.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Software</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="rb3DOpenGL">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The OpenGL renderer may be faster than software and supports graphical enhancements, but is more prone to glitches.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>OpenGL (Classic)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="rb3DCompute">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A compute-shader renderer with the accuracy of software and the speed of the GPU. Requires OpenGL 4.3.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>OpenGL (Compute shader)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="rb3DVulkanFull">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A compute-shader renderer built on Vulkan. Same speed and accuracy as the OpenGL compute renderer, and it works where OpenGL 4.3 is unavailable, such as macOS.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Vulkan</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="rb3DVulkan">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The Vulkan compute renderer runs the 3D engine on Vulkan and composites the 2D layers with OpenGL. Superseded by the full Vulkan renderer; kept only for compatibility with older settings.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Vulkan (3D compute, GL 2D)</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item row="0" column="1" alignment="Qt::AlignmentFlag::AlignTop">
    <widget class="QGroupBox" name="grpRendererOptions">
     <property name="title">
      <string>Renderer options</string>
     </property>
     <layout class="QVBoxLayout" name="layoutRendererOptions">
      <item>
       <widget class="QLabel" name="lblResolution">
        <property name="text">
         <string>Internal resolution:</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="cbxGLResolution">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The resolution at which the 3D graphics are rendered. Higher resolutions look sharper when the window is enlarged, but may cause glitches.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="cbxComputeHiResCoords">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Use the extra precision in vertex positions that the compute and Vulkan renderers can carry, reducing wobble on some geometry.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>High-resolution coordinates</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="cbBetterPolygons">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Enabling this may help reduce distortion on quads and more complex polygons, but may also reduce performance. Applies to the classic OpenGL renderer.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Improved polygon splitting</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="cbSoftwareThreaded">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Run the software renderer across multiple threads. Yields better performance on multi-core CPUs.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Multithreaded</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="cbDither">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Dither the final image to smooth the DS's 6-bit colour banding on gradients. Purely at the output; does not affect rendering accuracy. Vulkan renderer only.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Dither output</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="cbTexFilter">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Bilinear-filter magnified textures so upscaled surfaces are smooth rather than blocky. Softens the DS's sharp nearest-neighbour look. Vulkan renderer only.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Smooth textures</string>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="optionsSpacer">
        <property name="orientation">
         <enum>Qt::Orientation::Vertical</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size>
          <width>20</width>
          <height>0</height>
         </size>
        </property>
       </spacer>
      </item>
     </layout>
    </widget>
   </item>
   <item row="1" column="0" colspan="2">
    <widget class="QGroupBox" name="grpDisplay">
     <property name="title">
      <string>Display</string>
     </property>
     <layout class="QVBoxLayout" name="layoutDisplay">
      <item>
       <widget class="QCheckBox" name="cbGLDisplay">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Draw the DS screens to the window using the GPU. Usually improves frame pacing, and is required by the hardware 3D renderers.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>GPU-accelerated display</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="cbVSync">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Synchronize the video output to your monitor's refresh rate. Requires GPU-accelerated display.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>VSync</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="layoutVSyncInterval">
        <item>
         <widget class="QLabel" name="lblVSyncInterval">
          <property name="whatsThis">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The interval at which to synchronize to the monitor's refresh rate. Set to 1 for a 60Hz monitor, 2 for 120Hz, ...&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>VSync interval:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="sbVSyncInterval">
          <property name="whatsThis">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The interval at which to synchronize to the monitor's refresh rate. Set to 1 for a 60Hz monitor, 2 for 120Hz, ...&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="minimum">
           <number>1</number>
          </property>
          <property name="maximum">
           <number>20</number>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="vsyncSpacer">
          <property name="orientation">
           <enum>Qt::Orientation::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item row="2" column="0" colspan="2">
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Orientation::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::StandardButton::Cancel|QDialogButtonBox::StandardButton::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
